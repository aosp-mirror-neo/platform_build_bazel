load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    package_name = "vulkan-headers",
    copyright_notice = "Copyright 2015-2023 The Khronos Group Inc.",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
    license_text = "LICENSE.md",
    package_url = "https://github.com/KhronosGroup/Vulkan-Headers",
    visibility = ["//visibility:public"],
)

exports_files(["LICENSE.md"])

cc_library(
    name = "vulkan_headers",
    hdrs = glob(["include/**/*"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
